<!doctype html>
<html lang="{{ site.language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ site.name }}{% if page.title %} / {{ page.title }}{% endif %}</title>
  <meta name="description" content="{{ page.description or site.description }}">
  <meta name="generator" content="{{ site.generator }}">
  <meta name="author" content="{{ site.author }}">
  <link rel="canonical" href="{{ site.url.rstrip('/') }}{{ page.url }}">
  <meta name="robots" content="index, follow">

  {% if site.googleAnalyticsId %}
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.googleAnalyticsId }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '{{ site.googleAnalyticsId }}');
  </script>
  {% endif %}

  <link rel="stylesheet" href="/assets/css/fonts.css">
  <link rel="stylesheet" href="/assets/css/reset.css">
  <link rel="stylesheet" href="/assets/css/variables.css">
  <link rel="stylesheet" href="/assets/css/base.css">
  <link rel="stylesheet" href="/assets/css/typography.css">
  <link rel="stylesheet" href="/assets/css/layout.css">
  <link rel="stylesheet" href="/assets/css/code.css">
  <link rel="stylesheet" href="/assets/css/kate.css" media="(prefers-color-scheme: light)">
  <link rel="stylesheet" href="/assets/css/breezedark.css" media="(prefers-color-scheme: dark)">
  <link rel="stylesheet" href="/assets/css/theme.css">
  <link rel="stylesheet" href="/assets/css/theme.dark.css" media="(prefers-color-scheme: dark)">

  <!-- Standard favicon -->
  <link rel="icon" href="/assets/img/favicons/favicon.ico" sizes="any">

  <!-- Modern browsers (crisp on all DPIs) -->
  <link rel="icon" href="/assets/img/favicons/favicon.svg" type="image/svg+xml">

  <!-- Optional PNG fallbacks -->
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/img/favicons/favicon-16.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicons/favicon-32.png">
  <link rel="icon" type="image/png" sizes="128x128" href="/assets/img/favicons/favicon-128.png">

  <!-- High-res Apple touch icon -->
  <link rel="apple-touch-icon" href="/assets/img/favicons/apple-touch-icon-180x180.png">
</head>
<body>
  <div id="container">
    <nav class="navbar">
      <div class="logo">
        <span>N</span> {{ site.name }}
      </div>
      <ul class="nav-links">
        <li><a href="{{ site.url }}">Home</a></li>
        <li><a href="/rss.xml">Feed</a></li>
      </ul>
    </nav>
    <main>
      {% block main %}
      {{ content }}
      {% endblock %}
    </main>
    <footer>
      <p>© 2020 - 2026 {{ site.author }} - {{ site.generator }} - v{{ site.version }} - {{ site.language }}</p>
    </footer>
  </div>
</body>
</html>
