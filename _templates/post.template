{% extends "base.template" %}

{% block main %}
		<article class="page">
		<div class="header">
  		<p class="page_meta">
  		<time>{{ page.date }}</time>
  		</p>
  		<h1>{{ page.title }}</h1>
  		{% if page.description %}
  		<p class="description">{{ page.description }}</p>
  		{% endif %}
  		</div>
  		{{ content }}
		</article>
{% endblock %}
